{
  "name": "voltara-home",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:types": "supabase gen types typescript --project-id yvtaokyuxniflztesons --schema public > packages/shared/src/database.types.ts && prettier --write packages/shared/src/database.types.ts",
    "db:push": "supabase db push",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop",
    "dev:admin": "pnpm --filter @voltara/home-admin dev",
    "dev:phone": "pnpm --filter @voltara/home tunnel:go",
    "dev:stop": "node scripts/dev.mjs --stop"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.3.3",
    "qrcode": "^1.5.4",
    "supabase": "^2.31.8",
    "turbo": "^2.5.0",
    "typescript": "~5.5.3",
    "typescript-eslint": "^8.2.0"
  }
}
