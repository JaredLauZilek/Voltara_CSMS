{
  "name": "@voltara/home",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "tunnel": "expo start --dev-client --tunnel",
