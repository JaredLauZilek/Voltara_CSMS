# Build context = repo root (deploy with: flyctl deploy -c infra/fly.staging.toml
# from the repo root, or the deploy-gateway workflow).

FROM node:22-alpine AS build
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/ocpp-gateway/package.json apps/ocpp-gateway/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile --filter @voltara/ocpp-gateway...
COPY packages/shared packages/shared
COPY apps/ocpp-gateway apps/ocpp-gateway
# tsup bundles the workspace packages into dist/, so /out only needs the real
# npm dependencies. `--legacy` because pnpm v10 otherwise refuses to deploy a
# workspace that does not opt into injected dependencies.
RUN pnpm --filter @voltara/ocpp-gateway build \
  && pnpm --filter @voltara/ocpp-gateway --prod deploy --legacy /out

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /out /app
EXPOSE 9221
CMD ["node", "dist/index.js"]
