# Local development points at `supabase start` (see docs/dev-setup.md).
# The anon key is printed by `supabase start` / `supabase status`.
# `/supabase` routes through the Vite dev-server proxy (vite.config.ts) so the
# app works from a Codespace, where the browser cannot reach 127.0.0.1:54321
# directly. On a purely local machine http://127.0.0.1:54321 works too.
VITE_SUPABASE_URL=/supabase
VITE_SUPABASE_ANON_KEY=
VITE_GATEWAY_URL=wss://voltara-gateway-staging.fly.dev

# Dev only: skip the login screen by signing in as a seeded user automatically.
# Ignored by production builds. Seeded logins are listed in docs/dev-setup.md.
# VITE_DEV_AUTO_LOGIN_EMAIL=jared@voltara.com.my
# VITE_DEV_AUTO_LOGIN_PASSWORD=voltara-dev
